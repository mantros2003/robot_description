<?xml version="1.0" ?>
<scenario>
    <!-- 1. Static Obstacles (Walls) -->
    <!-- These define the boundaries so pedestrians don't wander off into infinity -->
    <obstacle x1="-10" y1="-10" x2="10" y2="-10"/>
    <obstacle x1="10" y1="-10" x2="10" y2="10"/>
    <obstacle x1="10" y1="10" x2="-10" y2="10"/>
    <obstacle x1="-10" y1="10" x2="-10" y2="-10"/>

    <!-- 2. Waypoints -->
    <!-- Define areas you want pedestrians to walk towards. Radius defines how wide the area is -->
    <waypoint id="wp1" x="-8" y="8" r="2"/>
    <waypoint id="wp2" x="8" y="-8" r="2"/>
    <waypoint id="wp3" x="-8" y="-8" r="2"/>
    <waypoint id="wp4" x="8" y="8" r="2"/>

    <!-- 3. Agents (The Moving Obstacles) -->
    <!-- type="1" is default pedestrian. n="10" means spawn 10 agents. -->
    <agent x="-5" y="5" n="10" dx="2" dy="2" type="1">
        <!-- The agents will randomly choose between these waypoints -->
        <addwaypoint id="wp1"/>
        <addwaypoint id="wp2"/>
        <addwaypoint id="wp3"/>
        <addwaypoint id="wp4"/>
    </agent>
</scenario>
